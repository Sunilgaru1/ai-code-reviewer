==========================================

DJANGO CORE SETTINGS

==========================================

Generate a random 50-character string for production

SECRET_KEY=your_super_secret_django_key_here

MUST be False in production!

DEBUG=False

Add your cloud domain here (e.g., my-ai-bot.onrender.com)

ALLOWED_HOSTS=localhost,127.0.0.1

==========================================

PRODUCTION SECURITY

==========================================

Set these to True when deploying to the cloud to force HTTPS

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

==========================================

GITHUB APP CREDENTIALS

==========================================

GITHUB_APP_ID=your_github_app_id
GITHUB_WEBHOOK_SECRET=your_webhook_secret

Paste the raw RSA Private Key string here for Cloud Deployment

GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYourKeyDataHere...\n-----END RSA PRIVATE KEY-----"

==========================================

AI ENGINE CREDENTIALS

==========================================

GEMINI_API_KEY=your_gemini_api_key

==========================================

DATABASE & REDIS (Usually auto-injected by Cloud Providers)

==========================================

DB_ENGINE=django.db.backends.mysql

DB_NAME=ai_reviewer_db

DB_USER=myuser

DB_PASSWORD=mypassword

DB_HOST=db

DB_PORT=3306

CELERY_BROKER_URL=redis://redis:6379/0

CELERY_RESULT_BACKEND=redis://redis:6379/0